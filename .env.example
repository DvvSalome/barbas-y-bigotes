# Supabase (se llenan al crear el proyecto en la nube)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# n8n (recordatorios + lista de espera / notificación alternativa)
# Nota: las credenciales N8N_* viven en n8n, no acá — la app no llama a n8n;
# es n8n el que llama a Supabase (service role) y a /api/push (PUSH_CRON_SECRET).
N8N_BASE_URL=
N8N_API_KEY=

# Web push (VAPID) + secreto de la ruta /api/push que disparan los crons de n8n.
# Valores reales SOLO en .env.local / Vercel — jamás al repo.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# PUSH_CRON_SECRET=
